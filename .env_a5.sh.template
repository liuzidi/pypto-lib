#!/usr/bin/env bash
# One-shot environment activation for A5 device runs of pypto-lib.
#
# Copy this to `.env_a5.sh` and fill in the local paths, then
# `source .env_a5.sh` before running any operator.
#
# This template is checked in (no private paths). Your local `.env_a5.sh`
# is git-ignored so you can keep real paths in it. See
# docs/get-started/installation.md for the canonical setup procedure and
# docs/run-deepseek-v4-pro-single-ops.md §2 for the A5-specific walkthrough.
set -e

# --- CANN (must be sourced so simpler's A5 onboard binaries link/run) ---
export CANN_ROOT=/usr/local/Ascend/cann-9.1.0-beta.3   # adjust to your CANN
# shellcheck disable=SC1091
source "$CANN_ROOT/set_env.sh" >/dev/null 2>&1 || true

# --- pypto-lib venv (Python 3.11, scikit-build-core/nanobind/torch) ---
source <your-venv-path>/bin/activate                    # e.g. .venv under the repo

# --- pip mirror (use this if pypi.org/simple/ is flaky on your host) ---
export PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
export PIP_TRUSTED_HOST=mirrors.aliyun.com

# --- roots: where pypto-lib, pypto (+runtime/simpler), pto-isa, ptoas live ---
export PYPTO_LIB_ROOT=<path-to>/pypto-lib
export PYPTO_WORKSPACE=$(dirname "$PYPTO_LIB_ROOT")
export PYPTO_ROOT=$PYPTO_WORKSPACE/pypto
export PTO_ISA_ROOT=$PYPTO_WORKSPACE/pto-isa
export PTOAS_ROOT=$PYPTO_WORKSPACE/ptoas-bin

# --- pypto-lib on PYTHONPATH so `from golden import run, run_jit` resolves ---
export PYTHONPATH="$PYPTO_LIB_ROOT${PYTHONPATH:+:$PYTHONPATH}"

# --- keep simpler's pto-isa pin explicit (matches $PYPTO_ROOT/runtime/pto_isa.pin) ---
# Read it dynamically so a pypto bump doesn't need this file edited:
export SIMPLER_PTO_ISA_COMMIT=$(cat "$PYPTO_ROOT/runtime/pto_isa.pin")
